# =============================================================================
# Environment Variables — TEMPLATE ONLY
# =============================================================================
# Copy this file to `.env.local` for local development:
#   cp .env.example .env.local
#
# `.env.local` is .gitignored — never commit it.
#
# For Vercel deployments, the same three variables must also be set at:
#   Vercel Dashboard → Project → Settings → Environment Variables
#   Tick ALL THREE environments: Production + Preview + Development
# =============================================================================


# -----------------------------------------------------------------------------
# MongoDB Atlas connection string
# -----------------------------------------------------------------------------
# Get it from: Atlas → Database → Connect → Drivers → Node.js
# REPLACE the literal `<password>` placeholder with your actual DB password.
# Format: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?appName=Cluster0
MONGODB_URI=mongodb+srv://your_user:your_password@cluster0.xxxxx.mongodb.net/?appName=Cluster0


# -----------------------------------------------------------------------------
# Admin login password
# -----------------------------------------------------------------------------
# The password users type into the /login form to access the admin panel.
# Use a strong password. Compare against ADMIN_TOKEN below to log in.
ADMIN_PASSWORD=change-me-to-a-strong-password


# -----------------------------------------------------------------------------
# Admin API token
# -----------------------------------------------------------------------------
# The bearer token returned to the client after successful login.
# Every subsequent admin API call sends this as `Authorization: Bearer <token>`.
# Generate with:  openssl rand -hex 32
ADMIN_TOKEN=change-me-to-a-long-random-string


# -----------------------------------------------------------------------------
# Optional: allowed CORS origins (comma-separated)
# -----------------------------------------------------------------------------
# Leave empty to allow same-origin only. Set for cross-origin admin tools if needed.
# ALLOWED_ORIGINS=https://your-domain.vercel.app
